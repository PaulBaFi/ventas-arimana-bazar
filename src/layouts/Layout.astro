---
import "@/styles/global.css";
interface Props {
  title?: string;
}
const { title = "Arimana Bazar · Gestión de ventas" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/LOGO_APP.png" />
    <link rel="apple-touch-icon" href="/LOGO_APP.png" />

    <meta
      name="description"
      content="Sistema de Gestión de Ventas de Arimana Bazar."
    />
    <title>{title}</title>

    <link
      rel="preload"
      href="/fonts/NunitoSans.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
