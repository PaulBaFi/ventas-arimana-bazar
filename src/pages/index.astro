---
import Layout from "@/layouts/Layout.astro";
import { AdminShell } from "@/components/layout/AdminShell";
---

<Layout title="Inicio · Arimana Bazar">
  <AdminShell client:load title="Inicio">
    <section
      class="rounded-2xl border border-border-default bg-surface-card p-6 shadow-card sm:p-9"
    >
      <p class="text-sm font-bold uppercase tracking-wider text-primary-active">
        Entorno académico · Demostración
      </p>
      <h1 class="mt-3 text-3xl font-extrabold">Bienvenido a Arimana Bazar</h1>
      <p class="mt-3 max-w-2xl text-text-secondary">
        Esta maqueta utiliza datos ficticios guardados en este navegador. Las
        secciones se habilitarán progresivamente.
      </p>
      <a
        href="/usuarios/"
        class="mt-6 inline-flex rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-text-inverse hover:bg-primary-hover"
        >Administrar usuarios</a
      >
    </section>
    <section class="mt-6 grid gap-4 sm:grid-cols-2">
      <article class="rounded-xl border border-border-default bg-white p-5">
        <p class="text-sm font-semibold text-text-secondary">Sesión activa</p><p
          class="mt-2 font-bold"
        >
          Acceso simulado por rol
        </p><p class="mt-1 text-sm text-text-secondary">
          Las cuentas de demostración no almacenan contraseñas.
        </p>
      </article><article
        class="rounded-xl border border-border-default bg-white p-5"
      >
        <p class="text-sm font-semibold text-text-secondary">
          Persistencia local
        </p><p class="mt-2 font-bold">IndexedDB</p><p
          class="mt-1 text-sm text-text-secondary"
        >
          Los cambios permanecen en este navegador.
        </p>
      </article>
    </section>
  </AdminShell>
</Layout>
